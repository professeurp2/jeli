# Copy to .env and fill in. Never commit .env.
# Each channel is enabled as soon as its variables are set.

# --- WhatsApp Cloud API (Meta) — target channel -------------------------------
# Permanent system-user token (the dashboard's temporary token expires after 24 h)
WHATSAPP_ACCESS_TOKEN=
# WhatsApp → API Setup → "Phone number ID" (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# App settings → Basic → App secret (used to check the signature of every webhook call)
WHATSAPP_APP_SECRET=
# Any random string; paste the same value in WhatsApp → Configuration → Webhook
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v25.0

# --- Telegram — default channel while WhatsApp is being set up ----------------
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of the deployed app (e.g. https://jeli.up.railway.app).
# Set → Telegram webhook mode. Empty → polling mode (local development).
PUBLIC_URL=
# Required with PUBLIC_URL: random string Telegram sends back with every update.
TELEGRAM_WEBHOOK_SECRET=

# --- Core -----------------------------------------------------------------------
# Google AI Studio key (Gemini LLM + embeddings) — used from Day 3
GEMINI_API_KEY=
# Supabase Postgres connection string (with pgvector) — used from Day 2
DATABASE_URL=

LOG_LEVEL=INFO
