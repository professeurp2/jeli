# Copy to .env and fill in. Never commit .env.
# Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- WhatsApp through WAHA — target channel -----------------------------------
# Where Jeli reaches the WAHA gateway
WAHA_URL=http://localhost:3000
# API key of the WAHA gateway (the same value is given to WAHA)
WAHA_API_KEY=
# Signs every webhook call from WAHA to Jeli (given to WAHA as WHATSAPP_HOOK_HMAC_KEY)
WAHA_WEBHOOK_HMAC_KEY=
# Password of the WAHA dashboard, where you scan the QR code (used by docker-compose.yml)
WAHA_DASHBOARD_PASSWORD=
# WAHA_SESSION=default
# Comma-separated group ids (…@g.us) Jeli may listen to. Empty: every group the number is in.
# Jeli logs the id of each group that talks to it, so you can copy it from the logs.
WHATSAPP_GROUP_IDS=
# A group message starting with this name is addressed to Jeli, like a mention
# BOT_NAME=Jeli
# Anti-ban limits (defaults shown)
# WHATSAPP_USER_LIMIT=5
# WHATSAPP_USER_WINDOW_SECONDS=600
# WHATSAPP_HOURLY_LIMIT=120
# WHATSAPP_MIN_SEND_INTERVAL_SECONDS=3

# --- Telegram — fallback channel ----------------------------------------------
TELEGRAM_BOT_TOKEN=
# Set → Telegram webhook mode (deployed). Empty → polling mode (local development).
PUBLIC_URL=
# Required with PUBLIC_URL: random string Telegram sends back with every update.
TELEGRAM_WEBHOOK_SECRET=

# --- Knowledge base -------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey (embeddings, then answers)
GEMINI_API_KEY=
# Supabase Postgres through the pooler, as the jeli_app role (see db/schema.sql):
# postgresql://jeli_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Answer models in fallback order, and the "I don't know" threshold
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# ANSWER_MIN_SIMILARITY=0.60
# TRANSCRIPTION_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Authors never used in answers, e.g. other bots in the group (comma-separated names or numbers)
IGNORED_AUTHORS=
# Readable chat names in sources: chat-id=Name;other-id=Other name
CHAT_LABELS=
# Timezone of the phone that exported the chat (exports carry local times)
# EXPORT_TIMEZONE=UTC
# INDEX_INTERVAL_SECONDS=300

LOG_LEVEL=INFO
