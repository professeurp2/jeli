# Copy to .env and fill in. Never commit .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL of the deployed app (e.g. https://jeli.up.railway.app).
# Set it → webhook mode. Leave it empty → polling mode (local development).
PUBLIC_URL=

# Required in webhook mode: random string Telegram sends back with every update,
# so nobody else can post fake messages to the webhook.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Google AI Studio key (Gemini LLM + embeddings) — used from Day 3
GEMINI_API_KEY=

# Supabase Postgres connection string (with pgvector) — used from Day 2
DATABASE_URL=

LOG_LEVEL=INFO
